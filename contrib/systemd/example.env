# Settings of the geesefs@<name> service, copy to /etc/geesefs/<name>.env
# and make it readable only by root: chmod 600 /etc/geesefs/<name>.env

# Bucket, or bucket:prefix to mount only objects under a prefix
BUCKET=my-bucket
MOUNTPOINT=/mnt/my-bucket

AWS_ACCESS_KEY_ID=AKID1234567890
AWS_SECRET_ACCESS_KEY=MY-SECRET-KEY

# Extra geesefs options, split on spaces. Values can't contain spaces.
# Alibaba Cloud OSS needs --subdomain and its region, for example:
#   --endpoint https://oss-cn-beijing-internal.aliyuncs.com --subdomain --region oss-cn-beijing
GEESEFS_OPTS=--endpoint https://s3.amazonaws.com -o allow_other --file-mode 0666 --dir-mode 0777 --memory-limit 4000 --max-disk-cache-size 51200
